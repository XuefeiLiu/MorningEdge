# Morning Edge - Environment variables example
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# -----------------------------------------------------------------------------
# Required: Database (Supabase)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
# Use either DB_API_KEY or SUPABASE_KEY for the anon/service key
DB_API_KEY=your_supabase_anon_key_here
# SUPABASE_KEY=your_supabase_anon_key_here

# -----------------------------------------------------------------------------
# Required for pipeline & LLM: OpenAI
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4  # For storyline/relationship/filter LLM calls

# -----------------------------------------------------------------------------
# Optional: News & data API keys (enable specific collectors)
# -----------------------------------------------------------------------------
# ALPHA_VANTAGE_API_KEY=
# MASSIVE_API_KEY=
# FINANCIAL_DATASETS_API_KEY=
# MARKETAUX_API_KEY=
# GEMINI_API_KEY=
# FMP_API_KEY=

# -----------------------------------------------------------------------------
# Embeddings: OpenAI text-embedding-3-small (1536-dim). Uses OPENAI_API_KEY (same as LLM).
# -----------------------------------------------------------------------------
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small  # default; 1536-dim. DB columns must be vector(1536).
# EMBEDDING_TIMEOUT=90
# Run backend/scripts/migrations/embedding_1536_openai.sql before first backfill if columns are not yet vector(1536).

# -----------------------------------------------------------------------------
# Optional: 10-K/10-Q filings RAG and filing-in-storyline
# -----------------------------------------------------------------------------
# FILING_BACKFILL_DAYS=1825
# FILING_UPDATE_DAYS=60
# PIPELINE_CREATE_FILING_INSIGHTS=true
# PIPELINE_RUN_FILING_UPDATE=false

# -----------------------------------------------------------------------------
# Ask (POST /storylines/custom): rate limit and token caps to limit OpenAI usage
# -----------------------------------------------------------------------------
# ASK_RATE_LIMIT_PER_MINUTE=10
# ASK_RATE_LIMIT_WINDOW_SECONDS=60
# ASK_DAILY_QUOTA_PER_IP=0
# ASK_MAX_CONCURRENT=0
# CUSTOM_STORY_MAX_TOKENS=800
# CUSTOM_STORY_CONTEXT_ARTICLES=12
# CUSTOM_STORY_ARTICLE_SUMMARY_CHARS=300

# -----------------------------------------------------------------------------
# Optional: Pipeline / long story cutoff
# -----------------------------------------------------------------------------
# MIN_LONG_STORY_ARTICLES=4   # Minimum useful articles to create a long storyline (default 4)
# LONG_STORY_DAYS=1825        # Long-story retrieval window in days (default 5 years)

# -----------------------------------------------------------------------------
# Optional: Price Impact chart (Alpaca bars). Uses IEX feed by default (free tier).
# -----------------------------------------------------------------------------
# alpaca-api-key=your_alpaca_key
# alpaca-secret-key=your_alpaca_secret
# ALPACA_BARS_FEED=iex   # default; use "sip" only if you have Algo Trader Plus (recent SIP data)

# -----------------------------------------------------------------------------
# Optional: Model & filter tuning
# -----------------------------------------------------------------------------
# OPENAI_MODEL=gpt-5.2
# GEMINI_MODEL=gemini-pro-latest
# OPENAI_FILTER_BATCH_SIZE=10
# OPENAI_FILTER_MAX_CONCURRENT_BATCHES=10
# RAG_RETRIEVAL_LIMIT=10
